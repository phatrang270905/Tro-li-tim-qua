{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "tro-li-tim-qua",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "tro-li-tim-qua.online", "custom_domain": true },
    { "pattern": "www.tro-li-tim-qua.online", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
